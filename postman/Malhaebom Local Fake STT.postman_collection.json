{
  "info": {
    "name": "Malhaebom Local Fake STT",
    "description": "local-fake-stt 프로필에서 문제 제시부터 음성 답변 제출까지 확인합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "sessionQuestionId",
      "value": ""
    },
    {
      "key": "speechAnswerId",
      "value": ""
    },
    {
      "key": "transcript",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 학습 세션 생성",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"학습 세션이 생성된다\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.status).to.eql(\"IN_PROGRESS\");",
              "});",
              "pm.collectionVariables.set(\"sessionId\", String(body.data.sessionId));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"childId\": 1,\n  \"topicId\": 3,\n  \"difficulty\": \"EASY\",\n  \"questionTypes\": [\"PICTURE_DESCRIPTION\"],\n  \"questionCount\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/learning-sessions"
      }
    },
    {
      "name": "2. 현재 문제 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"현재 문제가 제시된다\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.questionText).to.eql(\"What is the boy doing?\");",
              "});",
              "pm.collectionVariables.set(\"sessionQuestionId\", String(body.data.sessionQuestionId));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/learning-sessions/{{sessionId}}/questions/next"
      }
    },
    {
      "name": "3. 음성 업로드",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"Fake STT 결과가 반환된다\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.transcript).to.eql(\"He is running.\");",
              "  pm.expect(body.data.confidence).to.eql(0.94);",
              "});",
              "pm.collectionVariables.set(\"speechAnswerId\", String(body.data.speechAnswerId));",
              "pm.collectionVariables.set(\"transcript\", body.data.transcript);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "audio",
              "type": "file",
              "src": "C:\\Users\\shinj\\IdeaProjects\\malheabom\\backend\\postman\\files\\fake-audio.mp3",
              "contentType": "audio/mpeg"
            }
          ]
        },
        "url": "{{baseUrl}}/learning-sessions/{{sessionId}}/questions/{{sessionQuestionId}}/speech"
      }
    },
    {
      "name": "4. 답변 제출",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"STT 답변이 정답으로 채점된다\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.result).to.eql(\"CORRECT\");",
              "  pm.expect(body.data.score).to.eql(100);",
              "  pm.expect(body.data.attemptNo).to.eql(1);",
              "  pm.expect(body.data.matchedKeywords).to.eql([]);",
              "  pm.expect(body.data.missingKeywords).to.eql([]);",
              "  pm.expect(body.data.feedbackText).to.eql(\"정확하고 또박또박 잘 말했어요!\");",
              "  pm.expect(body.data.feedbackTtsUrl).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"speechAnswerId\": {{speechAnswerId}},\n  \"answerText\": \"{{transcript}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/learning-sessions/{{sessionId}}/questions/{{sessionQuestionId}}/answers"
      }
    },
    {
      "name": "5. 학습 세션 확인",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"학습 세션이 완료된다\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.status).to.eql(\"COMPLETED\");",
              "  pm.expect(body.data.correctCount).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/learning-sessions/{{sessionId}}"
      }
    }
  ]
}
